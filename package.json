{
  "name": "agy-pulse",
  "version": "1.0.0",
  "description": "High-speed Rust native ops engine with per-conversation token-savings telemetry, outline/symbol reads, compact git inspection, structured shell execution, background job supervision, and spillover result cache for Google Antigravity.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:rust": "cargo build --release --manifest-path native/Cargo.toml",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.mjs",
    "doctor": "node scripts/install.mjs doctor",
    "stress": "node scripts/stress-benchmark.mjs",
    "stress:quick": "node scripts/stress-benchmark.mjs --quick",
    "install-plugin": "node scripts/install.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
